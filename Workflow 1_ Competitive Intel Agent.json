    {
      "parameters": {
        "jsCode": "var allRows = $input.all().map(function(i) { return i.json; });\nif (allRows.length === 0) throw new Error('No data in sheet');\nvar latest = 0;\nfor (var i = 0; i < allRows.length; i++) { var t = new Date(allRows[i]['Timestamp'] || 0).getTime(); if (t > latest) latest = t; }\nvar cutoff = latest - (30 * 60 * 1000);\nvar batch = allRows.filter(function(r) { return new Date(r['Timestamp'] || 0).getTime() >= cutoff; });\nvar company = '';\ntry { company = $('Extract Company Name').item.json.company_name; } catch(e) { company = 'target company'; }\nreturn [{ json: { target_company: company, competitor_count: batch.length, research_data: JSON.stringify(batch, null, 2) } }];"
      },
