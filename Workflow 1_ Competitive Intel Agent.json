    {
      "parameters": {
        "jsCode": "var item = $input.first().json;\nvar briefing = item.response || item.output || item.text || 'Briefing failed';\nif (typeof briefing === 'object') briefing = JSON.stringify(briefing);\nvar company = '';\ntry { company = $('Extract Company Name').item.json.company_name; } catch(e) { company = 'Unknown'; }\nvar count = '';\ntry { count = $('Filter Batch').item.json.competitor_count; } catch(e) { count = '?'; }\nvar date = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\nreturn [{ json: { output: '**Competitive Intelligence Brief — ' + company + '**\\n_' + date + ' · ' + count + ' competitors analyzed_\\n\\n' + briefing } }];"
