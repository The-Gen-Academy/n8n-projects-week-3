        "jsCode": "var comp = $('Loop').item.json;\nvar extracted = {};\ntry { var ei = $('Extract Data').item.json; var er = ei.response || ei.output || ei.text || ''; if (typeof er === 'object') er = JSON.stringify(er); var m = er.match(/```(?:json)?\\s*([\\s\\S]*?)```/); var js = m ? m[1].trim() : er.substring(er.indexOf('{'), er.lastIndexOf('}') + 1); extracted = JSON.parse(js); } catch(e) { extracted = { pricing: 'Parse error', key_features: '-', positioning: '-', strengths: '-', weaknesses: '-' }; }\nvar ni = $input.first().json; var news = ni.response || ni.output || ni.text || 'No news';\nif (typeof news === 'object') news = JSON.stringify(news);\nreturn [{ json: { timestamp: new Date().toISOString(), company_name: comp.competitor_name, reason: comp.reason, pricing: extracted.pricing || '-', key_features: typeof extracted.key_features === 'object' ? JSON.stringify(extracted.key_features) : (extracted.key_features || '-'), positioning: extracted.positioning || '-', strengths: typeof extracted.strengths === 'object' ? JSON.stringify(extracted.strengths) : (extracted.strengths || '-'), weaknesses: typeof extracted.weaknesses === 'object' ? JSON.stringify(extracted.weaknesses) : (extracted.weaknesses || '-'), recent_news: String(news).trim() } }];"
