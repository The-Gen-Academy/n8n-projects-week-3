    {
      "parameters": {
        "jsCode": "var item = $input.first().json;\nvar raw = item.response || item.output || item.text || '';\nif (typeof raw === 'object') raw = JSON.stringify(raw);\n\nfunction buildItems(parsed) {\n  return parsed.competitors.slice(0, 3).map(function(c) {\n    return { json: { competitor_name: c.name, competitor_website: c.website || 'https://' + c.name.toLowerCase().replace(/\\s+/g, '') + '.com', reason: c.reason || 'Direct competitor', target_company: parsed.company_summary || '', market: parsed.market || '' } };\n  });\n}\nfunction tryParse(str) { try { var p = JSON.parse(str); if (p.competitors && Array.isArray(p.competitors)) return p; } catch(e) {} return null; }\nvar result = null;\nvar m = raw.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\nif (m) result = tryParse(m[1].trim());\nif (!result) { var s = raw.indexOf('{'); var e = raw.lastIndexOf('}'); if (s >= 0 && e > s) result = tryParse(raw.substring(s, e + 1)); }\nif (!result) throw new Error('Parse failed: ' + raw.substring(0, 300));\nreturn buildItems(result);"
      },
